  agendarEtapa3Pack.tabela.botaoAgendar(linha).click()
})

// modalidade
agendarEtapa3Pack.formulario.modalidadePresencial().click()

// período de escolha
agendarEtapa3Pack.formulario.periodoEscolha().click()
cy.contains('08').click()
cy.contains('31').click()

// data de nomeação
agendarEtapa3Pack.formulario.dataNomeacao().type('31/07/2026')

// candidatos e sessão
agendarEtapa3Pack.formulario.candidatos().clear().type('10')
agendarEtapa3Pack.formulario.sessao().clear().type('10')

// hora convocação
agendarEtapa3Pack.formulario.horaConvocacao().click()
cy.contains('07:00').click()
cy.contains('17:00').click()

// adicionar período
agendarEtapa3Pack.formulario.adicionarPeriodo().click()

// salvar
agendarEtapa3Pack.botoes.salvarAvancar().click()





