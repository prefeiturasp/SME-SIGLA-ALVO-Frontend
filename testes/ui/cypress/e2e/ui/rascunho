export const agendarEtapa3Pack = {

  // ===============================
  // 📄 TÍTULO DA ETAPA
  // ===============================
  tituloEtapa: () =>
    cy.contains('Agendar'),

  // ===============================
  // 📊 TABELA DE CARGOS
  // ===============================
  tabela: {

    linhas: () =>
      cy.get('tbody tr'),

    primeiraLinha: () =>
      cy.get('tbody tr').first(),

    botaoAgendar: (linha) =>
      linha.find('button').contains('Agendar')
  },

  // ===============================
  // 🧾 FORMULÁRIO DE AGENDAMENTO
  // ===============================
  formulario: {

    // ---- Modalidade
    modalidadePresencial: () =>
      cy.contains('.ant-radio-wrapper', 'Presencial'),

    modalidadeOnline: () =>
      cy.contains('.ant-radio-wrapper', 'Online'),

    // ---- Período de escolha (range)
    periodoEscolha: () =>
      cy.contains('label', '*Escolha em')
        .parentsUntil('.ant-form-item')
        .parent()
        .find('.ant-picker-range'),

    // ---- Data de nomeação
    dataNomeacao: () =>
      cy.contains('label', '*Nomeação em')
        .parentsUntil('.ant-form-item')
        .parent()
        .find('input'),

    // ---- Candidatos
    candidatos: () =>
      cy.contains('label', '*Candidatos')
        .parentsUntil('.ant-form-item')
        .parent()
        .find('input'),

    // ---- Sessão
    sessao: () =>
      cy.contains('label', '*Sessão')
        .parentsUntil('.ant-form-item')
        .parent()
        .find('input'),

    // ---- Hora da convocação (range time picker)
    horaConvocacao: () =>
      cy.contains('label', '*Hora da convocação')
        .parentsUntil('.ant-form-item')
        .parent()
        .find('.ant-picker-range'),

    // ---- Botão adicionar período
    adicionarPeriodo: () =>
      cy.contains('button', 'Adicionar periodo')
  },

  // ===============================
  // 🔘 BOTÕES FINAIS
  // ===============================
  botoes: {

    salvarAvancar: () =>
      cy.contains('button', 'Salvar e avançar')
  }
}


